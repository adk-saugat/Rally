# iOS simulator: http://localhost:8080
# Android emulator: http://10.0.2.2:8080
# Physical device: your computer's LAN address, e.g. http://192.168.1.42:8080
# Phone and computer must be on the same network.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Native Google Maps SDK keys (restrict to each app/platform and Maps SDK).
# Fill these in before building your own app; these are not EXPO_PUBLIC variables.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Choose your own stable identifier before distribution.
RALLY_APP_ID=com.rally.app
